# Application-level permissions
# Export all objects in the app globally so jinja2format and searchbnf are available across all apps

[]
access = read : [ * ], write : [ sc_admin, admin, power ]
export = system

[collections/jinja_templates]
access = read : [ * ], write : [ sc_admin, admin, power ]
export = system

[transforms/jinja_templates_lookup]
access = read : [ * ], write : [ sc_admin, admin, power ]
export = system
